PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS Cryptographic Algebra v0.1.
# Public algorithm specifications are realized through the existing PNCS relational core.
# Named cryptographic algorithms are canonical compositions of lower relational primitives.

OP K.IDENTITY IDENTITY value
OP K.DISTINGUISH DIFFERENCE left right
OP K.COMPOSE COMPOSITION left relation right
OP K.TRANSFORM TRANSFORM source map target
OP K.CONDITION CONDITION subject relation object
OP K.RESOLVE RESOLVE relation
OP K.DERIVE DERIVE premises result
OP K.ORDER ORDER before after

# Generic word/byte algebra.
OP CRYPTO.WORD.ADD_MOD32 DERIVE u32_pair add_mod_2^32 u32
OP CRYPTO.WORD.XOR32 DERIVE u32_pair bitwise_xor u32
OP CRYPTO.WORD.ROTL32 TRANSFORM u32_rotation left_rotate_32 u32
OP CRYPTO.WORD.ROTL64 TRANSFORM u64_rotation left_rotate_64 u64
OP CRYPTO.BYTES.XOR DERIVE equal_length_byte_strings bitwise_xor bytes
OP CRYPTO.BYTES.CONCAT COMPOSITION K.ORDER K.COMPOSE
OP CRYPTO.BYTES.PAD DERIVE bytes_block_size canonical_padding bytes
OP CRYPTO.BYTES.TRUNCATE TRANSFORM bytes_length prefix_truncate bytes
OP CRYPTO.BYTES.LE32_ENCODE TRANSFORM u32 little_endian_32 bytes4
OP CRYPTO.BYTES.LE32_DECODE TRANSFORM bytes4 little_endian_32 u32
OP CRYPTO.BYTES.LE64_ENCODE TRANSFORM u64 little_endian_64 bytes8
OP CRYPTO.BYTES.LE64_DECODE TRANSFORM bytes8 little_endian_64 u64

# ChaCha ARX radical.
OP CRYPTO.CHACHA.ARX_A COMPOSITION CRYPTO.WORD.ADD_MOD32 CRYPTO.WORD.XOR32 CRYPTO.WORD.ROTL32
OP CRYPTO.CHACHA.ARX_B COMPOSITION CRYPTO.WORD.ADD_MOD32 CRYPTO.WORD.XOR32 CRYPTO.WORD.ROTL32
OP CRYPTO.CHACHA.QUARTER_ROUND COMPOSITION CRYPTO.CHACHA.ARX_A CRYPTO.CHACHA.ARX_B CRYPTO.CHACHA.ARX_A CRYPTO.CHACHA.ARX_B
OP CRYPTO.CHACHA.COLUMN_ROUND COMPOSITION CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND
OP CRYPTO.CHACHA.DIAGONAL_ROUND COMPOSITION CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND CRYPTO.CHACHA.QUARTER_ROUND
OP CRYPTO.CHACHA.DOUBLE_ROUND COMPOSITION CRYPTO.CHACHA.COLUMN_ROUND K.ORDER CRYPTO.CHACHA.DIAGONAL_ROUND
OP CRYPTO.CHACHA.ROUNDS20 DERIVE chacha_state CRYPTO.CHACHA.DOUBLE_ROUND_x10 chacha_state20
OP CRYPTO.CHACHA.FEED_FORWARD DERIVE initial_state_state20 add_mod_2^32_wordwise final_state
OP CRYPTO.CHACHA.BLOCK COMPOSITION CRYPTO.CHACHA.ROUNDS20 CRYPTO.CHACHA.FEED_FORWARD CRYPTO.BYTES.LE32_ENCODE
OP CRYPTO.CHACHA.STREAM COMPOSITION CRYPTO.CHACHA.BLOCK K.ORDER CRYPTO.BYTES.XOR

# Poly1305 prime-field authenticator.
OP CRYPTO.POLY1305.CLAMP TRANSFORM r128 poly1305_clamp r130
OP CRYPTO.POLY1305.BLOCK_VALUE TRANSFORM block_le append_one_bit integer
OP CRYPTO.POLY1305.ADD DERIVE accumulator_block integer_add integer
OP CRYPTO.POLY1305.MUL DERIVE accumulator_r integer_multiply integer
OP CRYPTO.POLY1305.REDUCE TRANSFORM integer modulo_2^130_minus_5 field_element
OP CRYPTO.POLY1305.ACCUMULATE COMPOSITION CRYPTO.POLY1305.BLOCK_VALUE CRYPTO.POLY1305.ADD CRYPTO.POLY1305.MUL CRYPTO.POLY1305.REDUCE
OP CRYPTO.POLY1305.FINAL DERIVE accumulator_s add_mod_2^128 tag128
OP CRYPTO.POLY1305.MAC COMPOSITION CRYPTO.POLY1305.CLAMP CRYPTO.POLY1305.ACCUMULATE CRYPTO.POLY1305.FINAL

# Keccak-f[1600] five-step round algebra.
OP CRYPTO.KECCAK.THETA DERIVE state1600 column_parity_diffusion state1600
OP CRYPTO.KECCAK.RHO TRANSFORM state1600 lane_rotations state1600
OP CRYPTO.KECCAK.PI TRANSFORM state1600 lane_permutation state1600
OP CRYPTO.KECCAK.CHI DERIVE state1600 nonlinear_row_mix state1600
OP CRYPTO.KECCAK.IOTA TRANSFORM state_round_index round_constant_injection state1600
OP CRYPTO.KECCAK.ROUND COMPOSITION CRYPTO.KECCAK.THETA K.ORDER CRYPTO.KECCAK.RHO K.ORDER CRYPTO.KECCAK.PI K.ORDER CRYPTO.KECCAK.CHI K.ORDER CRYPTO.KECCAK.IOTA
OP CRYPTO.KECCAK.F1600 DERIVE state1600 CRYPTO.KECCAK.ROUND_x24 state1600
OP CRYPTO.KECCAK.SPONGE COMPOSITION CRYPTO.BYTES.PAD CRYPTO.BYTES.XOR CRYPTO.KECCAK.F1600 K.ORDER CRYPTO.BYTES.TRUNCATE
OP CRYPTO.SHA3_512 COMPOSITION CRYPTO.KECCAK.SPONGE K.IDENTITY


# BLAKE2b commitment algebra.
OP CRYPTO.BLAKE2B.G DERIVE v_words_message_words add_xor_rotate64 mixed_words
OP CRYPTO.BLAKE2B.ROUND DERIVE state_message_schedule CRYPTO.BLAKE2B.G_x8 state
OP CRYPTO.BLAKE2B.COMPRESS DERIVE hash_state_block_counter_last CRYPTO.BLAKE2B.ROUND_x12 hash_state
OP CRYPTO.BLAKE2B.HASH COMPOSITION CRYPTO.BYTES.PAD CRYPTO.BLAKE2B.COMPRESS CRYPTO.BYTES.TRUNCATE
OP CRYPTO.BLAKE2B_256 COMPOSITION CRYPTO.BLAKE2B.HASH K.IDENTITY

# SHA-3/SHAKE specializations from the same Keccak sponge.
OP CRYPTO.SHA3_256 COMPOSITION CRYPTO.KECCAK.SPONGE K.IDENTITY
OP CRYPTO.SHAKE256 COMPOSITION CRYPTO.KECCAK.SPONGE K.IDENTITY

# HMAC and HKDF over the native SHA3-512 path.
OP CRYPTO.HMAC.KEY_NORMALIZE CONDITION key_length gt sha3_512_block_size
OP CRYPTO.HMAC.IPAD DERIVE normalized_key xor_0x36 ipad_key
OP CRYPTO.HMAC.OPAD DERIVE normalized_key xor_0x5c opad_key
OP CRYPTO.HMAC.INNER COMPOSITION CRYPTO.HMAC.IPAD CRYPTO.BYTES.CONCAT CRYPTO.SHA3_512
OP CRYPTO.HMAC.OUTER COMPOSITION CRYPTO.HMAC.OPAD CRYPTO.BYTES.CONCAT CRYPTO.SHA3_512
OP CRYPTO.HMAC.SHA3_512 COMPOSITION CRYPTO.HMAC.KEY_NORMALIZE CRYPTO.HMAC.INNER CRYPTO.HMAC.OUTER
OP CRYPTO.HKDF.EXTRACT COMPOSITION CRYPTO.HMAC.SHA3_512 K.IDENTITY
OP CRYPTO.HKDF.EXPAND_STEP COMPOSITION CRYPTO.BYTES.CONCAT CRYPTO.HMAC.SHA3_512
OP CRYPTO.HKDF.EXPAND DERIVE prk_info_length CRYPTO.HKDF.EXPAND_STEP_chain okm
OP CRYPTO.HKDF.SHA3_512 COMPOSITION CRYPTO.HKDF.EXTRACT K.ORDER CRYPTO.HKDF.EXPAND

# AEAD composition.
OP CRYPTO.CHACHA20_POLY1305.OTK COMPOSITION CRYPTO.CHACHA.BLOCK CRYPTO.BYTES.TRUNCATE
OP CRYPTO.CHACHA20_POLY1305.MAC_DATA COMPOSITION CRYPTO.BYTES.CONCAT CRYPTO.BYTES.PAD CRYPTO.BYTES.LE64_ENCODE
OP CRYPTO.CHACHA20_POLY1305.ENCRYPT COMPOSITION CRYPTO.CHACHA20_POLY1305.OTK K.ORDER CRYPTO.CHACHA.STREAM K.ORDER CRYPTO.CHACHA20_POLY1305.MAC_DATA CRYPTO.POLY1305.MAC
OP CRYPTO.CHACHA20_POLY1305.VERIFY COMPOSITION CRYPTO.CHACHA20_POLY1305.MAC_DATA CRYPTO.POLY1305.MAC K.DISTINGUISH K.CONDITION K.RESOLVE
OP CRYPTO.CHACHA20_POLY1305.DECRYPT COMPOSITION CRYPTO.CHACHA20_POLY1305.VERIFY K.ORDER CRYPTO.CHACHA.STREAM

VECTOR V.CRYPTO.CHACHA.QUARTER_ROUND "PNCS.crypto.chacha.quarter_round.v0.1" PRECISE
VECTOR V.CRYPTO.CHACHA.BLOCK "PNCS.crypto.chacha20.block.v0.1" PRECISE
VECTOR V.CRYPTO.KECCAK.ROUND "PNCS.crypto.keccak.round.v0.1" PRECISE
VECTOR V.CRYPTO.HKDF.SHA3_512 "PNCS.crypto.hkdf.sha3_512.v0.1" PRECISE
VECTOR V.CRYPTO.AEAD.CHACHA20_POLY1305 "PNCS.crypto.aead.chacha20_poly1305.v0.1" PRECISE

EMIT CRYPTO.CHACHA20_POLY1305.ENCRYPT
EMIT CRYPTO.HKDF.SHA3_512
