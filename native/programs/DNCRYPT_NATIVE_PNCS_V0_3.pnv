PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# DNCrypt v0.3 native PNCS relational port — PhaseNav entropy binding v0.1.
# Deterministic cryptography is bound to PNCS_CRYPTOGRAPHIC_ALGEBRA_V0_1.
# Entropy admission is bound to PNCS_PHASE_ENTROPY_V0_1 with measured health/min-entropy evidence.

# Canonical PNCS primitive closure used by this program.
OP K.IDENTITY IDENTITY value
OP K.DISTINGUISH DIFFERENCE left right
OP K.COMPOSE COMPOSITION left relation right
OP K.TRANSFORM TRANSFORM source map target
OP K.CONDITION CONDITION subject relation object
OP K.RESOLVE RESOLVE relation
OP K.DERIVE DERIVE premises result
OP K.ORDER ORDER before after

# Native PNCS cryptographic algebra bindings.
OP DNC.CRYPTO.SHAKE256 COMPOSITION CRYPTO.SHAKE256 K.IDENTITY
OP DNC.CRYPTO.BLAKE2B256 COMPOSITION CRYPTO.BLAKE2B_256 K.IDENTITY
OP DNC.CRYPTO.SHA3_256 COMPOSITION CRYPTO.SHA3_256 K.IDENTITY
OP DNC.CRYPTO.HKDF_SHA3_512 COMPOSITION CRYPTO.HKDF.SHA3_512 K.IDENTITY
OP DNC.CRYPTO.CHACHA20_POLY1305.ENCRYPT COMPOSITION CRYPTO.CHACHA20_POLY1305.ENCRYPT K.IDENTITY
OP DNC.CRYPTO.CHACHA20_POLY1305.DECRYPT COMPOSITION CRYPTO.CHACHA20_POLY1305.DECRYPT K.IDENTITY
# PhaseNav entropy path: 4pi->2pi sheet geometry + trajectory residuals + health gate + 256-bit conditioned seed.
OP DNC.ENTROPY.PHASE.COLLECT COMPOSITION PATH.PNCS.PHASE_ENTROPY K.IDENTITY
OP DNC.ENTROPY.PHASE.SEED COMPOSITION DNC.ENTROPY.PHASE.COLLECT ENTROPY.CONDITION_SHAKE256
OP DNC.ENTROPY.PHASE.EXPAND TRANSFORM phase_entropy_seed256 DNC.CRYPTO.SHAKE256 domain_separated_entropy_bytes
OP DNC.ENTROPY.MASTER_KEY32 DERIVE phase_entropy_seed256 32_bytes master_key_entropy
OP DNC.ENTROPY.GENOME64 DERIVE phase_entropy_seed256 64_bytes initial_genome_entropy
OP DNC.ENTROPY.MESSAGE44 DERIVE phase_entropy_seed256 44_bytes salt_nonce_entropy
OP DNC.ENTROPY.MUTATION_N64 DERIVE phase_entropy_seed256 population_size_x64 mutation_entropy

# 36D genome realization.
OP DNC.GENOME.OPERATOR36 TRANSFORM entropy DNC.CRYPTO.SHAKE256 operator_vector36_u8
OP DNC.GENOME.ROUTE36 TRANSFORM entropy DNC.CRYPTO.SHAKE256 route_permutation36
OP DNC.GENOME.PHASE_SEED TRANSFORM entropy DNC.CRYPTO.SHAKE256 phase_seed32
OP DNC.GENOME.MUTATION_NONCE TRANSFORM entropy DNC.CRYPTO.SHAKE256 mutation_nonce16
OP DNC.GENOME.IDENTITY COMPOSITION DNC.GENOME.OPERATOR36 DNC.GENOME.ROUTE36 DNC.GENOME.PHASE_SEED DNC.GENOME.MUTATION_NONCE DNC.CRYPTO.BLAKE2B256
OP DNC.GENOME.PHASE36 TRANSFORM phase_seed32 DNC.CRYPTO.SHAKE256 phase36
OP DNC.GENOME.INVARIANT COMPOSITION K.DISTINGUISH K.CONDITION K.RESOLVE

# 36D surface and proper monotone tick.
OP DNC.SURFACE.OMEGA36 TRANSFORM phase_seed32 DNC.CRYPTO.SHAKE256 omega36
OP DNC.SURFACE.INIT COMPOSITION DNC.GENOME.PHASE36 DNC.SURFACE.OMEGA36 K.COMPOSE
OP DNC.SURFACE.COUPLING DERIVE operator_vector36_route36 routed_phase_coupling36
OP DNC.SURFACE.STEP COMPOSITION K.ORDER DNC.SURFACE.COUPLING K.TRANSFORM
OP DNC.SURFACE.TRANSITION COMPOSITION DNC.SURFACE.STEP K.ORDER K.IDENTITY
OP DNC.SURFACE.COMMITMENT TRANSFORM phi36_omega36_tick DNC.CRYPTO.BLAKE2B256 surface_commitment

# Adversarial fitness and mutation gate.
OP DNC.FITNESS.SIGNIFICANCE CONDITION p_value le significance_alpha
OP DNC.FITNESS.ADVANTAGE DERIVE p_value_delta_bits_delta_alpha positive_significant_advantage
OP DNC.FITNESS.RISK DERIVE structural_leakage_predictability_avalanche_bias_advantage adversarial_risk
OP DNC.FITNESS.INVARIANTS CONDITION decrypt_failures_integrity_failures eq zero_pair
OP DNC.MUTATION.DELTA TRANSFORM parent_operator36_entropy DNC.CRYPTO.SHAKE256 mutated_operator36
OP DNC.MUTATION.ROUTE TRANSFORM parent_route36_entropy DNC.CRYPTO.SHAKE256 mutated_route36
OP DNC.MUTATION.GENOME COMPOSITION DNC.MUTATION.DELTA DNC.MUTATION.ROUTE DNC.GENOME.PHASE_SEED DNC.GENOME.MUTATION_NONCE DNC.GENOME.IDENTITY
OP DNC.MUTATION.GATE CONDITION adversarial_risk gt mutation_risk_threshold
OP DNC.POPULATION.GENERATE COMPOSITION DNC.MUTATION.GATE K.ORDER DNC.MUTATION.GENOME
OP DNC.POPULATION.COMMITMENT TRANSFORM ordered_genome_ids DNC.CRYPTO.BLAKE2B256 population_commitment

# Exact population coverage, invariant filter, Pareto selection and promotion.
OP DNC.EVALUATION.COVERAGE CONDITION evaluated_genome_id_set eq population_genome_id_set
OP DNC.PARETO.OBJECTIVES DERIVE fitness_records six_objective_matrix
OP DNC.PARETO.NONDOMINATED RESOLVE six_objective_matrix
OP DNC.PARETO.RANK DERIVE survivor_records risk_avalanche_neg_throughput_genome_id_order
OP DNC.PROMOTION.RISK CONDITION chosen_risk_plus_minimum_improvement lt parent_risk
OP DNC.PROMOTION.THROUGHPUT CONDITION chosen_throughput ge parent_throughput_times_minimum_ratio
OP DNC.PROMOTION.INVARIANTS COMPOSITION DNC.EVALUATION.COVERAGE DNC.FITNESS.INVARIANTS DNC.PROMOTION.RISK DNC.PROMOTION.THROUGHPUT
OP DNC.PROMOTION.SELECT COMPOSITION DNC.PARETO.OBJECTIVES DNC.PARETO.NONDOMINATED DNC.PARETO.RANK DNC.PROMOTION.INVARIANTS
OP DNC.PROMOTION.TRANSITION COMPOSITION DNC.PROMOTION.SELECT K.ORDER DNC.SURFACE.TRANSITION
OP DNC.PROMOTION.RECEIPT TRANSFORM parent_candidate_policy_surface DNC.CRYPTO.BLAKE2B256 promotion_receipt

# Message encryption/decryption under the selected resident generation.
OP DNC.MESSAGE.KEY COMPOSITION DNC.CRYPTO.HKDF_SHA3_512 K.COMPOSE
OP DNC.MESSAGE.AAD DERIVE protocol_generation_tick_genome_surface_parent_useraad canonical_aad
OP DNC.MESSAGE.ENCRYPT COMPOSITION DNC.MESSAGE.KEY DNC.MESSAGE.AAD K.ORDER DNC.CRYPTO.CHACHA20_POLY1305.ENCRYPT
OP DNC.MESSAGE.RECEIPT COMPOSITION DNC.CRYPTO.BLAKE2B256 DNC.CRYPTO.SHA3_256
OP DNC.MESSAGE.ENVELOPE COMPOSITION DNC.MESSAGE.ENCRYPT DNC.MESSAGE.RECEIPT
OP DNC.MESSAGE.VERIFY COMPOSITION DNC.MESSAGE.RECEIPT K.DISTINGUISH K.CONDITION K.RESOLVE
OP DNC.MESSAGE.DECRYPT COMPOSITION DNC.MESSAGE.VERIFY K.ORDER DNC.MESSAGE.KEY DNC.CRYPTO.CHACHA20_POLY1305.DECRYPT

# Reversible 2-bit DNA transport.
OP DNC.TRANSPORT.DNA_ENCODE TRANSFORM envelope_bytes dna_2bit_acgt dna_sequence
OP DNC.TRANSPORT.DNA_DECODE TRANSFORM dna_sequence dna_2bit_acgt envelope_bytes
OP DNC.TRANSPORT.DNA_ROUNDTRIP COMPOSITION DNC.TRANSPORT.DNA_ENCODE DNC.TRANSPORT.DNA_DECODE K.IDENTITY

# Native resident adaptation path.
OP PATH.DNCRYPT.ADAPT COMPOSITION DNC.FITNESS.RISK DNC.MUTATION.GATE DNC.POPULATION.GENERATE DNC.POPULATION.COMMITMENT DNC.EVALUATION.COVERAGE DNC.PROMOTION.SELECT DNC.PROMOTION.TRANSITION DNC.PROMOTION.RECEIPT
OP PATH.DNCRYPT.ENCRYPT COMPOSITION DNC.MESSAGE.KEY DNC.MESSAGE.AAD DNC.MESSAGE.ENCRYPT DNC.MESSAGE.RECEIPT DNC.MESSAGE.ENVELOPE
OP PATH.DNCRYPT.DECRYPT COMPOSITION DNC.MESSAGE.VERIFY DNC.MESSAGE.KEY DNC.MESSAGE.DECRYPT
OP PATH.DNCRYPT.TRANSPORT COMPOSITION DNC.TRANSPORT.DNA_ENCODE DNC.TRANSPORT.DNA_DECODE
OP PATH.DNCRYPT.ENTROPY COMPOSITION DNC.ENTROPY.PHASE.COLLECT DNC.ENTROPY.PHASE.SEED DNC.ENTROPY.PHASE.EXPAND
OP PATH.DNCRYPT.RESIDENT COMPOSITION PATH.DNCRYPT.ENTROPY PATH.DNCRYPT.ADAPT PATH.DNCRYPT.ENCRYPT PATH.DNCRYPT.DECRYPT PATH.DNCRYPT.TRANSPORT

VECTOR V.DNC.GENOME36 "PNCS.DNCrypt.v0.3.genome36" PRECISE
VECTOR V.DNC.SURFACE36 "PNCS.DNCrypt.v0.3.surface36" PRECISE
VECTOR V.DNC.ADAPT "PNCS.DNCrypt.v0.3.adaptation" PRECISE
VECTOR V.DNC.RESIDENT "PNCS.DNCrypt.v0.3.resident_program" PRECISE

EMIT PATH.DNCRYPT.RESIDENT
